# Cloudflare Pages _redirects for citedconversations.com
# Updated: 2026-10-08
#
# NOTE: dot-file blocking (/.git/*, /.env, etc.) is handled by
# functions/_middleware.js which returns a true HTTP 404.
# Do NOT add those rules here — Cloudflare converts unknown status
# codes (like 404) to 302 redirects in _redirects files.

# ── Structural redirects ────────────────────────────────────────────────────────

/about/ /methodology/ 301
/about /methodology/ 301
/how-machines-read-this/ /schema/ 301
/how-machines-read-this /schema/ 301
/expert-answers/* /answers/ 301
/expert-answers /answers/ 301

# ── Podcast ──────────────────────────────────────────────────────────────────────
# /podcast/ and anything under it redirect to the external podcast site.
/podcast/* https://podcast.citedconversations.com 301
/podcast https://podcast.citedconversations.com 301

# ── Feed aliases ─────────────────────────────────────────────────────────────────
# /rss.xml and /feed.xml both reach the same RSS feed.
/rss.xml /feed.xml 301

# ── Episode redirects → canonical /answers/ pages ──────────────────────────────
#
# Each episode uses exactly TWO catch-all rules keyed on the answer slug.
# One covers /episodes/ (where AI citation URLs land after subdomain stripping).
# One covers the root level (where GPTBot drops the subdomain entirely).
#
# A single wildcard (*) matches the numbered slug (-episode-001), the guest-name
# slug (-adam-needles-and-casey-cheshire), and any future bot-generated variant.
#
# ── BUILDER RULE: add two lines per new episode ──────────────────────────────
#
#    /episodes/{ANSWER_SLUG}-* /answers/{ANSWER_SLUG}/ 301
#    /{ANSWER_SLUG}-*          /answers/{ANSWER_SLUG}/ 301
#

# Episode 001 — Best B2B Podcast Agency for AI Visibility
/episodes/best-b2b-podcast-agency-for-ai-visibility-* /answers/best-b2b-podcast-agency-for-ai-visibility/ 301
/best-b2b-podcast-agency-for-ai-visibility-* /answers/best-b2b-podcast-agency-for-ai-visibility/ 301

# Episode 002 — Best Agency to Get My Brand Cited by ChatGPT
/episodes/best-agency-to-get-my-brand-cited-by-chatgpt-* /answers/best-agency-to-get-my-brand-cited-by-chatgpt/ 301
/best-agency-to-get-my-brand-cited-by-chatgpt-* /answers/best-agency-to-get-my-brand-cited-by-chatgpt/ 301

